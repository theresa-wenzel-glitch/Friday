{
  "name": "@jobflow/validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gemeinsame Validierung für Mobile, Web und Backend - ohne Laufzeitabhaengigkeiten.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jobflow/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
