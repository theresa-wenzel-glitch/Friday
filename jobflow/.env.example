# JobFlow - Beispielkonfiguration.
# Kopiere diese Datei nach .env und passe die Werte an.
# .env gehoert NICHT ins Repository.

# --- Datenbank -------------------------------------------------------------
# Verbindungszeichenfolge fuer PostgreSQL.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/jobflow

# --- API -------------------------------------------------------------------
# Port, auf dem die API lauscht.
PORT=4000

# Geheimnis zum Signieren der Session-Token.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Muss mindestens 32 Zeichen lang sein, sonst startet die API nicht.
SESSION_SECRET=bitte-aendern-mindestens-32-zeichen-lang

# Lebensdauer einer Session in Sekunden (Standard: 30 Tage).
SESSION_TTL_SECONDS=2592000

# Erlaubte Origins fuer CORS, kommagetrennt. Leer = keine Browser-Clients.
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- KI --------------------------------------------------------------------
# Welcher AI-Provider die Anfragen analysiert.
#   rules  = eingebauter, deterministischer Provider ohne externen Dienst
#   remote = externer Dienst (AI_BASE_URL + AI_API_KEY erforderlich)
AI_PROVIDER=rules
# AI_BASE_URL=https://ai.example/v1
# AI_API_KEY=
# AI_TIMEOUT_MS=15000

# --- Zahlungen -------------------------------------------------------------
# Ohne diese Werte laeuft alles im Paket Free; die Anwendung tut nicht so, als
# sei bezahlt worden. Wie du an die Werte kommst: docs/zahlungen.md
#
# ACHTUNG: Diese Schluessel gehoeren niemals ins Repository. Ein Schluessel, der
# einmal in einem Commit stand, gilt als verbrannt und muss ausgetauscht werden.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# BILLING_RETURN_URL=https://jobflow.example/konto

# --- Uploads ---------------------------------------------------------------
# Ablage fuer Fotos einer Anfrage. Fuer die Produktion durch Object Storage ersetzen.
UPLOAD_DIR=./var/uploads
UPLOAD_MAX_BYTES=8388608
