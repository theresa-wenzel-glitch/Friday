{
  "name": "@jobflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL-Schema von JobFlow: Migrationen, Seeds und der Migrationslauf.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "migrations", "seeds"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "reset": "tsx src/cli.ts reset",
    "status": "tsx src/cli.ts status",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
