# Kopiere diese Datei nach .env.local und passe die Werte an.

# Passwort für den Moderations-Bereich unter /admin
# WICHTIG: Vor dem Livegang unbedingt auf einen langen, zufälligen Wert ändern.
ADMIN_PASSWORD=bitte-aendern

# Zufälliger Wert zum Signieren des Admin-Cookies.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bitte-aendern

# Speicherort der SQLite-Datenbank (Standard: ./data/westernhengste.db)
# DATABASE_PATH=/var/lib/westernhengste/westernhengste.db

# Öffentliche Basis-URL, wird u. a. für Canonical-Links genutzt.
# NEXT_PUBLIC_SITE_URL=https://westernhengste.example
