// Datenmodell fuer die Reining-Hengst-Datenbank.
// Standard ist SQLite. Fuer Produktion auf "postgresql" umstellen (siehe README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  farm         String?
  phone        String?
  country      String? // ISO-Code, z. B. DE, US
  role         String   @default("USER") // USER | ADMIN
  createdAt    DateTime @default(now())

  stallions Stallion[]
  favorites Favorite[]
}

model Stallion {
  id   String @id @default(cuid())
  slug String @unique

  // Identitaet
  name           String
  barnName       String?
  breed          String  @default("Quarter Horse") // Quarter Horse | Paint Horse | Appaloosa | ...
  registry       String? // AQHA / APHA / ApHC ...
  registrationNo String?
  yearOfBirth    Int?
  color          String?
  heightCm       Int?
  discipline     String  @default("Reining")

  // Abstammung (3 Generationen)
  sireName     String?
  sireSireName String?
  sireDamName  String?
  damName      String?
  damSireName  String?
  damDamName   String?
  allBreedUrl  String? // Direktlink zu allbreedpedigree.com

  // Sport & Zucht
  earnings     String? // z. B. "NRHA LTE $250,000"
  achievements String?
  description  String?
  offspring    String? // Erfolge der Nachkommen

  // Genetik / Gesundheit (5-Panel)
  panelHypp  String?
  panelHerda String?
  panelGbed  String?
  panelPssm1 String?
  panelMh    String?
  panelIma   String?

  // Standort & Verfuegbarkeit
  standingAt String?
  city       String?
  country    String  @default("US") // ISO-Code
  region     String  @default("US") // EU | US | WORLD (aus country abgeleitet)

  studFee       Int? // in ganzen Einheiten der Waehrung
  currency      String  @default("USD")
  feeOnRequest  Boolean @default(false)
  frozenSemen   Boolean @default(false)
  shippedSemen  Boolean @default(false)
  liveCover     Boolean @default(false)
  availableInEu Boolean @default(false)
  availableInUs Boolean @default(false)

  // Kontakt zum Besitzer
  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?

  // Meta
  source      String   @default("USER") // SEED | USER
  published   Boolean  @default(true)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  photos    Photo[]
  inquiries Inquiry[]
  favorites Favorite[]

  @@index([region])
  @@index([published])
}

model Photo {
  id          String   @id @default(cuid())
  stallionId  String
  stallion    Stallion @relation(fields: [stallionId], references: [id], onDelete: Cascade)
  // Entweder ein hochgeladenes Bild (in der Datenbank) ...
  data        Bytes?
  mimeType    String?
  // ... oder ein externer Bild-Link.
  externalUrl String?
  caption     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([stallionId])
}

model Inquiry {
  id         String   @id @default(cuid())
  stallionId String
  stallion   Stallion @relation(fields: [stallionId], references: [id], onDelete: Cascade)
  fromName   String
  fromEmail  String
  message    String
  createdAt  DateTime @default(now())

  @@index([stallionId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  stallionId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stallion   Stallion @relation(fields: [stallionId], references: [id], onDelete: Cascade)

  @@unique([userId, stallionId])
}
