{
  "$name": "Tippfeld Designsystem",
  "$beschreibung": "Design-Tokens für eine Fußball-Prognose- und Tippliga-App. Gleiche Werte wie tokens.css, hier maschinenlesbar für App-Builder, React Native, Flutter oder Figma.",
  "$version": "1.0.0",
  "$hinweis": "Alle Grafiken und Farben sind eigenständig entworfen. Es werden keine Vereins-, Liga- oder Sponsorenmarken nachgebildet.",

  "farbe": {
    "marke": {
      "nacht900": "#0B1220",
      "nacht800": "#101A2B",
      "nacht700": "#18253A",
      "nacht600": "#24344C",
      "nacht400": "#55688A",
      "kreide000": "#FFFFFF",
      "kreide050": "#F5F7F2",
      "kreide100": "#E9EDE4",
      "kreide200": "#D5DBCE",
      "kreide400": "#8C9689",
      "anstoss500": "#FF5A1F",
      "anstoss600": "#E24610",
      "anstoss100": "#FFE6DB"
    },
    "status": {
      "sieg": "#1F7A54",
      "siegFlaeche": "#D8EDE3",
      "remis": "#9A6C00",
      "remisFlaeche": "#FCEFD2",
      "niederlage": "#C8323B",
      "niederlageFlaeche": "#F8DCDD"
    },
    "rolle": {
      "hell": {
        "bg": "#F5F7F2",
        "bgErhoben": "#FFFFFF",
        "bgGedaempft": "#E9EDE4",
        "linie": "#D5DBCE",
        "text": "#101A2B",
        "textLeise": "#8C9689",
        "akzent": "#FF5A1F",
        "textAufAkzent": "#FFFFFF"
      },
      "dunkel": {
        "bg": "#101A2B",
        "bgErhoben": "#18253A",
        "bgGedaempft": "#24344C",
        "linie": "#24344C",
        "text": "#F5F7F2",
        "textLeise": "#55688A",
        "akzent": "#FF6F3C",
        "textAufAkzent": "#FFFFFF"
      }
    }
  },

  "schrift": {
    "familie": {
      "display": ["Oswald", "Arial Narrow", "sans-serif"],
      "text": ["Source Sans 3", "Segoe UI", "system-ui", "sans-serif"],
      "daten": ["IBM Plex Mono", "ui-monospace", "monospace"]
    },
    "groesse": {
      "anzeige": 44,
      "xl": 28,
      "l": 21,
      "m": 16,
      "s": 14,
      "xs": 12
    },
    "zeilenhoehe": { "eng": 1.05, "normal": 1.5 },
    "laufweiteLabel": 0.08,
    "regel": "Spielstände, Punkte und Wahrscheinlichkeiten immer mit Tabellenziffern (tabular-nums) setzen, damit Zahlen in Listen untereinander stehen."
  },

  "raum": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },

  "radius": { "s": 6, "m": 12, "l": 18, "rund": 999 },

  "rahmen": { "linie": 1, "statusstreifen": 4 },

  "schatten": {
    "karte": "0 1px 2px rgba(11,18,32,0.08), 0 8px 20px -12px rgba(11,18,32,0.25)",
    "dialog": "0 24px 60px -20px rgba(11,18,32,0.45)"
  },

  "bewegung": {
    "schnell": 120,
    "normal": 220,
    "kurve": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "regel": "prefers-reduced-motion respektieren: Animationen dann auf 0 setzen."
  },

  "antippflaeche": { "min": 44 },

  "ikonografie": {
    "raster": 24,
    "strichstaerke": 2,
    "abschluss": "rund",
    "farbe": "currentColor",
    "regel": "Nur abstrahierte Formen: Ball als Kreis mit Segmenten, Verein als neutraler Schild-Platzhalter mit Kürzel. Keine realen Wappen, Trikots oder Ligalogos."
  },

  "positionen": {
    "TW": { "kuerzel": "TW", "name": "Torwart", "farbe": "#E8A200" },
    "ABW": { "kuerzel": "ABW", "name": "Abwehr", "farbe": "#3F7BD8" },
    "MIT": { "kuerzel": "MIT", "name": "Mittelfeld", "farbe": "#1F7A54" },
    "ANG": { "kuerzel": "ANG", "name": "Angriff", "farbe": "#FF5A1F" }
  },

  "punktesystem": {
    "exaktesErgebnis": 5,
    "richtigeTordifferenz": 3,
    "richtigeTendenz": 2,
    "spielerTreffer": 2,
    "spielerVorlage": 1,
    "danebenliegend": 0,
    "regel": "Punkte sind additiv und pro Spiel gedeckelt. Höchstens eine Ergebnis-Stufe zählt (5, 3 oder 2 - nicht kumulativ), Spielerpunkte kommen obendrauf."
  }
}
