{
  "name": "@atlas/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas Planungs-Engine — Zielzerlegung, Validierung, Terminierung, Evaluation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "plan": "tsx src/cli.ts plan",
    "validate": "tsx src/cli.ts validate",
    "schedule": "tsx src/cli.ts schedule",
    "playbooks": "tsx src/cli.ts playbooks",
    "eval": "tsx src/eval/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "app": "tsx src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
